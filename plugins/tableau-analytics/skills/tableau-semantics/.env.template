# Tableau environment — used by the derivation queries in docs/DERIVATION.md
# (REST API + Metadata API). Copy this file to `.env` and fill in your own
# values. `.env` is gitignored; never commit real credentials.
#
# These are the same credentials used by the query-tableau-data skill.
TABLEAU_SERVER_URL="https://your-server.example.com"
TABLEAU_SITE_NAME="your-site"

# Personal Access Token (PAT) for authentication (recommended)
PAT_NAME=""
PAT_VALUE=""

# Transport options
# TABLEAU_USE_HTTP — Allow plain HTTP instead of HTTPS (true/false).
# Default is "false" (HTTPS enforced). Only set to "true" for local dev
# servers without TLS.
TABLEAU_USE_HTTP="false"