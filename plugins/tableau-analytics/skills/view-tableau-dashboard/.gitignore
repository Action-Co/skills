# Node / Bun runtime artifacts
node_modules/

# Runtime registry + scratch output
temp/*
!temp/.gitkeep

# Agent-produced artifacts (reports, exports) — the end user decides what to keep
artifacts/*
!artifacts/.gitkeep

# Login credentials (never commit)
.env

# Bridge debug log (diagnostics only)
bridge.log

# Local output files written with -o/--output
*.out.json
